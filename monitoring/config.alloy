// Grafana Alloy config for TBD Backend monitoring.
// Live at: C:\Program Files\GrafanaLabs\Alloy\config.alloy
//
// This file is the ACTUAL config installed on the monitoring machine.
// Copy it there if re-setting up on a new machine.
//
// Required environment variables (set at Machine scope):
//   GCLOUD_RW_API_KEY      — Grafana Cloud API key (set:alloy-data-write scope)
//   METRICS_BEARER_TOKEN   — Bearer token guarding the Render /metrics endpoint

// ── Alloy self-monitoring ──────────────────────────────────────────────────
prometheus.exporter.self "alloy_check" { }

discovery.relabel "alloy_check" {
  targets = prometheus.exporter.self.alloy_check.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "alloy_hostname"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/alloy-check"
  }
}

prometheus.scrape "alloy_check" {
  targets    = discovery.relabel.alloy_check.output
  forward_to = [prometheus.relabel.alloy_check.receiver]

  scrape_interval = "60s"
}

prometheus.relabel "alloy_check" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "(prometheus_target_sync_length_seconds_sum|prometheus_target_scrapes_.*|prometheus_target_interval.*|prometheus_sd_discovered_targets|alloy_build.*|prometheus_remote_write_wal_samples_appended_total|process_start_time_seconds)"
    action        = "keep"
  }
}

// ── Grafana Cloud remote write ─────────────────────────────────────────────
prometheus.remote_write "metrics_service" {
  endpoint {
    url = "https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push"

    basic_auth {
      username = "3389874"
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

loki.write "grafana_cloud_loki" {
  endpoint {
    url = "https://logs-prod-028.grafana.net/loki/api/v1/push"

    basic_auth {
      username = "1690612"
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// ── TBD Backend (Render) ───────────────────────────────────────────────────
// Scrapes the live /metrics endpoint every 15s and pushes to Grafana Cloud.
prometheus.scrape "tbd_backend" {
  targets = [{
    __address__ = "tbd-backend-gx8i.onrender.com",
  }]

  scheme          = "https"
  metrics_path    = "/metrics"
  scrape_interval = "15s"

  authorization {
    credentials = sys.env("METRICS_BEARER_TOKEN")
  }

  forward_to = [prometheus.relabel.tbd_backend.receiver]
}

prometheus.relabel "tbd_backend" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  // Tag every metric with service + env labels for easy filtering in Grafana.
  rule {
    target_label = "service"
    replacement  = "tbd-backend"
  }

  rule {
    target_label = "env"
    replacement  = "production"
  }
}
